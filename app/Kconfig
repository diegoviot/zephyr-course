menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"

if LED_SUBSYSTEM

    config APP_HEARTBEAT_PERIOD_MS
        int "App heartbeat period (100-2000)"
        range 100 2000
        default 500

    choice
        prompt "LED blink sleep time (1s (medium))"
        default BLINK_SLEEP_MEDIUM

        config BLINK_SLEEP_SLOW
            bool "2s (slow)"
        config BLINK_SLEEP_MEDIUM
            bool "1s (medium)"
        config BLINK_SLEEP_FAST
            bool "250ms (fast)"
    endchoice

    config BLINK_SLEEP_TIME_MS
        int
        default 250 if BLINK_SLEEP_FAST
        default 1000 if BLINK_SLEEP_MEDIUM
        default 2000 if BLINK_SLEEP_SLOW
        default 0

    menuconfig LED_ADVANCED
        bool "Advanced LED settings"

        if LED_ADVANCED

            config LED_BRIGHTNESS
                int "LED brightness (0-100)"
                range 0 100
                default 100

            config LED_FADE_DURATION_MS
                int "Fade duration (ms)"
                range 0 5000
                default 500

            menu "Expert settings"
            
                config LED_DEBUGGING
                    bool "Enable LED debugging"

                config LED_CUSTOM_BLINK
                    bool "Custom blink pattern"

            endmenu
        
        endif

endif

source "Kconfig.zephyr"
rsource "drivers/iomico_myled/Kconfig"